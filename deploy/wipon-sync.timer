# systemd-таймер: описывает, КОГДА запускать wipon-sync.service.
# Аналог cron, но с двумя важными плюсами:
#   1. Persistent=true — если сервер был выключен, пропущенный запуск
#      выполнится сразу после включения (cron бы его просто потерял).
#   2. systemd не запустит вторую копию, пока работает первая.

[Unit]
Description=Запуск синхронизации Wipon каждые 5 минут

[Timer]
# Первый запуск — через 2 минуты после загрузки сервера.
OnBootSec=2min
# Дальше — каждые 5 минут после завершения предыдущего запуска.
OnUnitActiveSec=5min
Persistent=true
# Разброс до 30 секунд, чтобы запросы не били в API строго по часам.
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
