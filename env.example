# Скопируйте этот файл в .env и подставьте свои значения:
#   Windows: copy env.example .env
#   Linux/Mac: cp env.example .env
# Файл .env НИКОГДА не коммитим в git — в нём пароли.

# ---------- Доступ к кассовой системе Wipon (Prosklad) ----------
WIPON_API_URL=https://api.wipon.kz

# --- Аккаунт 1 ---
# Логин — номер телефона, начиная с 7 (не с 8).
# employee_id узнаётся командой: python whoami.py
WIPON_USERNAME=77000000000
WIPON_PASSWORD=ваш_пароль
WIPON_EMPLOYEE_ID=1

# Необязательно: фильтр продаж по конкретному складу.
# Оставьте пустым, чтобы забирать продажи по всем складам.
WIPON_STOCK_ID=

# Необязательно: приставка к филиалам первого аккаунта в таблице.
# Оставьте пустой, если лист уже заполнен: иначе старые блоки
# («Основной склад») и новые («Магазин 1 / Основной склад») разойдутся.
WIPON_NAME=

# --- Аккаунт 2 (необязательно) ---
# Второй аккаунт включается, как только заполнен WIPON_2_USERNAME.
# Его филиалы встают на тот же лист правее, с приставкой из WIPON_2_NAME:
#   «Магазин 2 / Основной склад». Приставка обязательна по смыслу —
#   без неё одноимённые филиалы двух касс слились бы в один блок.
# employee_id второго аккаунта: python whoami.py --account 2
WIPON_2_USERNAME=
WIPON_2_PASSWORD=
WIPON_2_EMPLOYEE_ID=
WIPON_2_NAME=Магазин 2
WIPON_2_STOCK_ID=

# Формат дат для фильтров date_from / date_to.
# В документации тип параметра указан как "date", пример значения не приведён.
# Если API будет игнорировать фильтр или отвечать ошибкой,
# попробуйте: %Y-%m-%d %H:%M:%S
WIPON_DATE_FORMAT=%Y-%m-%d

# Сколько записей запрашивать за одну страницу
WIPON_PER_PAGE=100

# ---------- Google Таблица ----------
# Путь к JSON-ключу сервисного аккаунта.
# Можно относительный (от папки скрипта) или полный.
GOOGLE_CREDENTIALS_FILE=service_account.json

# ID таблицы — это часть ссылки между /d/ и /edit:
# https://docs.google.com/spreadsheets/d/ВОТ_ЭТОТ_ID/edit
GOOGLE_SPREADSHEET_ID=

# Название листа (вкладки). Если такого листа нет, скрипт создаст его сам.
GOOGLE_SHEET_NAME=Продажи

# ---------- Логика синхронизации ----------
# За сколько дней забрать продажи при самом первом запуске
SYNC_DAYS_BACK=3

# Насколько «перекрывать» предыдущий запуск (в днях), чтобы не потерять продажи.
# Дубликаты всё равно отсекаются по ID продажи.
SYNC_OVERLAP_DAYS=1

# Как часто перезагружать справочник товаров (часы)
ITEMS_CACHE_TTL_HOURS=24

# Сколько ID уже записанных продаж помнить в state.json
MAX_REMEMBERED_IDS=10000

# Дополнительно сверяться со столбцом «ID продажи» в самой таблице (1 = да).
# Страховка на случай, если state.json удалили.
RECONCILE_WITH_SHEET=1

# Часовой пояс магазина
TIMEZONE=Asia/Almaty

# ---------- Логи ----------
LOG_LEVEL=INFO
LOG_FILE=sync.log

# ---------- Сеть ----------
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# ---------- Фильтр товаров ----------
# Список названий через точку с запятой — в таблицу попадут только они.
# Пустая строка = писать все товары.
# Пример на два товара:
#   ITEM_FILTER=Магний 3x Nurelum;Омега 1000 мг 100 капсул
# Фильтр общий для всех аккаунтов.
ITEM_FILTER=

# Название листа со сводкой по филиалам (перезаписывается каждый запуск).
# Пусто = сводку не вести, итоги есть в строке ИТОГО каждого блока.
GOOGLE_SUMMARY_SHEET_NAME=
